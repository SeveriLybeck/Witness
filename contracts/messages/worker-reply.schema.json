{
  "$id": "worker-reply.schema.json",
  "title": "One line on the C# worker's stdout, answering the worker-request of the same id with `result` or `error`",
  "type": "object",
  "required": [
    "id",
    "method"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1
    },
    "method": {
      "enum": [
        "cfg",
        "references",
        "dependencies",
        "facts",
        "run"
      ]
    },
    "error": {
      "type": "object",
      "required": [
        "message"
      ],
      "properties": {
        "message": {
          "type": "string"
        }
      }
    }
  },
  "anyOf": [
    {
      "required": [
        "error"
      ]
    },
    {
      "required": [
        "result"
      ],
      "properties": {
        "method": {
          "const": "cfg"
        },
        "result": {
          "$ref": "#/$defs/cfg"
        }
      }
    },
    {
      "required": [
        "result"
      ],
      "properties": {
        "method": {
          "const": "references"
        },
        "result": {
          "$ref": "#/$defs/references"
        }
      }
    },
    {
      "required": [
        "result"
      ],
      "properties": {
        "method": {
          "const": "dependencies"
        },
        "result": {
          "$ref": "#/$defs/dependencies"
        }
      }
    },
    {
      "required": [
        "result"
      ],
      "properties": {
        "method": {
          "const": "facts"
        },
        "result": {
          "$ref": "#/$defs/facts"
        }
      }
    },
    {
      "required": [
        "result"
      ],
      "properties": {
        "method": {
          "const": "run"
        },
        "result": {
          "$ref": "#/$defs/run"
        }
      }
    }
  ],
  "$defs": {
    "operation": {
      "type": "object",
      "required": [
        "kind",
        "type",
        "syntax",
        "location"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "description": "Roslyn OperationKind, e.g. Invocation, PropertyReference, Conversion"
        },
        "type": {
          "type": [
            "string",
            "null"
          ],
          "description": "fully qualified type of the operation's value"
        },
        "symbol": {
          "type": [
            "string",
            "null"
          ],
          "description": "resolved symbol (method, property, field), documentation-comment ID"
        },
        "syntax": {
          "type": "string"
        },
        "location": {
          "$ref": "common.schema.json#/$defs/loc"
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        }
      }
    },
    "basicBlock": {
      "type": "object",
      "required": [
        "ordinal",
        "kind",
        "operations",
        "branch",
        "fallThrough",
        "conditional"
      ],
      "properties": {
        "ordinal": {
          "type": "integer",
          "minimum": 0
        },
        "kind": {
          "enum": [
            "entry",
            "exit",
            "block"
          ]
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "branch": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/operation"
            }
          ]
        },
        "jumpIfTrue": {
          "type": "boolean"
        },
        "fallThrough": {
          "type": [
            "integer",
            "null"
          ]
        },
        "conditional": {
          "type": [
            "integer",
            "null"
          ]
        },
        "throws": {
          "type": "boolean"
        }
      }
    },
    "graph": {
      "type": "object",
      "required": [
        "name",
        "location",
        "parameters",
        "blocks"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "location": {
          "$ref": "common.schema.json#/$defs/loc"
        },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "type": {
                "type": "string"
              }
            }
          }
        },
        "blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/basicBlock"
          }
        },
        "lambdas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graph"
          }
        }
      }
    },
    "cfg": {
      "type": "object",
      "required": [
        "methods"
      ],
      "properties": {
        "methods": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/graph"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "references": {
      "type": "object",
      "required": [
        "parts"
      ],
      "properties": {
        "parts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "references"
            ],
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/partId"
              },
              "references": {
                "$ref": "common.schema.json#/$defs/strings"
              },
              "symbols": {
                "$ref": "common.schema.json#/$defs/strings"
              }
            }
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "required": [
        "dependencies",
        "reach"
      ],
      "properties": {
        "dependencies": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "from",
              "to",
              "version",
              "via",
              "changed",
              "sites"
            ],
            "properties": {
              "from": {
                "$ref": "common.schema.json#/$defs/blockId"
              },
              "to": {
                "$ref": "common.schema.json#/$defs/blockId"
              },
              "version": {
                "enum": [
                  "old",
                  "new",
                  "both"
                ]
              },
              "via": {
                "enum": [
                  "reference",
                  "value"
                ]
              },
              "changed": {
                "type": "boolean"
              },
              "sites": {
                "type": "array",
                "items": {
                  "$ref": "common.schema.json#/$defs/loc"
                }
              }
            }
          }
        },
        "reach": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "block",
              "callSites"
            ],
            "properties": {
              "block": {
                "$ref": "common.schema.json#/$defs/blockId"
              },
              "callSites": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        }
      }
    },
    "fact": {
      "type": "object",
      "required": [
        "kind",
        "symbol",
        "location"
      ],
      "properties": {
        "kind": {
          "enum": [
            "public-type",
            "public-member",
            "new-file",
            "new-project",
            "new-dependency",
            "changed-signature",
            "new-diagnostic",
            "changed-wiring"
          ]
        },
        "symbol": {
          "type": "string"
        },
        "old": {
          "type": [
            "string",
            "null"
          ]
        },
        "new": {
          "type": [
            "string",
            "null"
          ]
        },
        "location": {
          "$ref": "common.schema.json#/$defs/locOrNull"
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "container": {
          "type": [
            "string",
            "null"
          ],
          "description": "containing type name"
        },
        "diagnostic": {
          "type": [
            "string",
            "null"
          ],
          "description": "resolved diagnostic id, e.g. MsgPack019"
        }
      }
    },
    "facts": {
      "type": "object",
      "required": [
        "facts"
      ],
      "properties": {
        "facts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fact"
          }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "required": [
        "id",
        "severity",
        "message",
        "location"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "severity": {
          "enum": [
            "hidden",
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "sideResult": {
      "type": "object",
      "required": [
        "diagnostics",
        "generated",
        "roundTrip",
        "milliseconds",
        "pid"
      ],
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/diagnostic"
          }
        },
        "generated": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "hintName",
              "text"
            ],
            "properties": {
              "hintName": {
                "type": "string"
              },
              "text": {
                "type": "string"
              }
            }
          }
        },
        "roundTrip": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": [
                "resolver",
                "sent",
                "received",
                "wire",
                "error"
              ],
              "properties": {
                "resolver": {
                  "enum": [
                    "generated-only",
                    "generated-and-builtin",
                    "standard"
                  ]
                },
                "sent": {
                  "type": "string"
                },
                "received": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "wire": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "error": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              }
            }
          ]
        },
        "milliseconds": {
          "type": "number",
          "minimum": 0
        },
        "pid": {
          "type": [
            "integer",
            "null"
          ],
          "description": "process that executed reviewer code (a bwrap child), null when nothing ran"
        }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "old",
        "new"
      ],
      "properties": {
        "old": {
          "$ref": "#/$defs/sideResult"
        },
        "new": {
          "$ref": "#/$defs/sideResult"
        },
        "reverted": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/sideResult"
            }
          ]
        },
        "workerPid": {
          "type": "integer"
        }
      }
    }
  }
}
