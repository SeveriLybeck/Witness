{
  "$id": "blocks.schema.json",
  "title": "blocks.json: groups of parts shown on the map",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "blocks": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "name", "category", "parts"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/blockId"},
        "name": {"type": "string", "minLength": 1},
        "category": {"$ref": "common.schema.json#/$defs/category"},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/partId"}}
      }}}
  }
}
