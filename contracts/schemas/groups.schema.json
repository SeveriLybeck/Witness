{
  "$id": "groups.schema.json",
  "title": "groups.json: mechanical change folded into quiet entries",
  "type": "object",
  "required": ["groups"],
  "properties": {
    "provenance": {"$ref": "common.schema.json#/$defs/provenance"},
    "groups": {"type": "array", "items": {
      "type": "object", "required": ["id", "rule", "parts", "count"],
      "properties": {
        "id": {"$ref": "common.schema.json#/$defs/groupId"},
        "rule": {"enum": ["identical-edit", "moved", "rename", "formatting"]},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "common.schema.json#/$defs/partId"}},
        "count": {"type": "integer", "minimum": 1}
      }}}
  }
}
