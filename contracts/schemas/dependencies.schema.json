{
  "$id": "dependencies.schema.json",
  "title": "dependencies.json: lines on the map between blocks",
  "type": "object",
  "required": [
    "dependencies"
  ],
  "properties": {
    "provenance": {
      "$ref": "common.schema.json#/$defs/provenance"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from",
          "to",
          "version",
          "via",
          "changed",
          "sites"
        ],
        "properties": {
          "from": {
            "$ref": "common.schema.json#/$defs/blockId"
          },
          "to": {
            "$ref": "common.schema.json#/$defs/blockId"
          },
          "version": {
            "enum": [
              "old",
              "new",
              "both"
            ]
          },
          "via": {
            "enum": [
              "reference",
              "value"
            ]
          },
          "changed": {
            "type": "boolean"
          },
          "sites": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/loc"
            }
          }
        }
      }
    },
    "reach": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "block",
          "callSites"
        ],
        "properties": {
          "block": {
            "$ref": "common.schema.json#/$defs/blockId"
          },
          "callSites": {
            "type": "integer",
            "minimum": 0
          },
          "sites": {
            "type": "array",
            "items": {
              "$ref": "common.schema.json#/$defs/loc"
            }
          }
        }
      }
    }
  }
}
