# source contracts/toolchain.env -- pinned toolchain from the nixos channel (D5, D42).
# Creates GC-rooted links under <repo>/.toolchain/ on first use, then puts them on PATH.
# TOOLCHAIN_QUIET=1 suppresses the version lines.
_tc_here="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
WITNESS_ROOT="$(cd "$_tc_here/.." && pwd)"
TOOLCHAIN="$WITNESS_ROOT/.toolchain"
export WITNESS_ROOT TOOLCHAIN
mkdir -p "$TOOLCHAIN"
_tc_pkgs="rustc cargo gcc pkg-config dotnet-sdk_8 lean4 z3 bubblewrap git coreutils bash cacert gnugrep gnused findutils curl"
for _tc_p in $_tc_pkgs; do
  [ -e "$TOOLCHAIN/$_tc_p" ] || [ -e "$TOOLCHAIN/$_tc_p-bin" ] || nix-build '<nixpkgs>' -A "$_tc_p" -o "$TOOLCHAIN/$_tc_p" >/dev/null 2>&1 \
    || echo "toolchain: nix-build $_tc_p failed" >&2
done
_tc_path=""
for _tc_p in rustc cargo gcc pkg-config dotnet-sdk_8 lean4 z3 bubblewrap; do _tc_path="$_tc_path$TOOLCHAIN/$_tc_p/bin:"; done
export PATH="$_tc_path$PATH"
export CI=1 GIT_PAGER=cat GIT_EDITOR=true DOTNET_NOLOGO=1 DOTNET_CLI_TELEMETRY_OPTOUT=1 MSBUILDDISABLENODEREUSE=1 CARGO_BUILD_JOBS=2
export LOCKS="$WITNESS_ROOT/contracts/LOCKS"
export SAMPLE_REPO="${SAMPLE_REPO:-/home/slopsoftwareagent1/Documents/junction/challenge_material/junction26-messagepack-csharp}"
if [ -z "${TOOLCHAIN_QUIET:-}" ]; then
  echo "rustc $(rustc --version | cut -d' ' -f2)"
  echo "dotnet $(DOTNET_CLI_HOME="${TMPDIR:-/tmp}" dotnet --version 2>/dev/null)"
  echo "lean $(lean --version | sed -E 's/.*version ([0-9.]+).*/\1/')"
  echo "z3 $(z3 --version | cut -d' ' -f3)"
fi
unset _tc_here _tc_p _tc_path _tc_pkgs
