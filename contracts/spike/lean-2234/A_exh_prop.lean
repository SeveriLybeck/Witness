    ∨ (E.ik i = none ∧ E.sk i = none ∧ E.suppress = true ∧ s.first = true ∧ E.fmtNull i = true) := by
  rcases h1 : E.ik i with _ | k1 <;> rcases h2 : E.sk i with _ | k2 <;>
  cases E.suppress <;> cases E.initOnly i <;> cases E.hasInit i <;>
  cases s.first <;> cases s.isInt <;> cases E.fmtNull i <;>
  (try cases has s.intM ‹IK›) <;> (try cases has s.strM ‹SK›) <;> simp_all
#print axioms exhaustive
